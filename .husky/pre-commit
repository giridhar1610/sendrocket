# --- Type Checking (runs on entire project) ---
echo "Running TypeScript type check..."
pnpm tsc --noEmit || { echo "TypeScript type check failed. Aborting commit."; exit 1; }

# --- Prettier Formatting (runs only on staged files) ---
echo "Running Prettier on staged files..."
# Get staged files and format them with Prettier
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | sed 's| |\\ |g')
if [ -n "$STAGED_FILES" ]; then # Check if there are any staged files
  prettier $STAGED_FILES --write --ignore-unknown || { echo "Prettier formatting failed. Aborting commit."; exit 1; }
  # Re-add formatted files to the staging area
  git update-index --again
else
  echo "No staged files to format with Prettier."
fi
echo "Running ESLint on src directory..."
pnpm eslint src || { echo "ESLint failed. Aborting commit."; exit 1; }

echo "Pre-commit checks passed!"